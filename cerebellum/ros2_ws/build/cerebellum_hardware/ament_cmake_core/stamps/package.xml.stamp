<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cerebellum_hardware</name>
  <version>0.0.0</version>
  <description>ros2_control hardware interface for cerebellum robot</description>
  <maintainer email="3357697374@qq.com">root</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 核心 -->
  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>

  <!-- ROS2 消息 -->
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>interfaces</depend>

  <!-- 自定义包 -->
  <depend>common</depend>
  <depend>drivers</depend>

  <!-- 系统依赖 -->
  <depend>libyaml-cpp-dev</depend>
  <depend>libcxx-serial-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>