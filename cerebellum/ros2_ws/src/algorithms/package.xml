<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>algorithms</name>
  <version>0.0.0</version>
  <description>Algorithms layer: IMU tools, IK, FK/odom, twist, attitude compensation</description>
  <maintainer email="3357697374@qq.com">root</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 核心依赖 -->
  <depend>rclcpp</depend>

  <!-- ROS2 标准消息和服务 -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>  

  <!-- TF -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <!-- 自定义消息 -->
  <depend>interfaces</depend>

  <!-- common 包（配置加载器） -->
  <depend>common</depend>

  <!-- 系统依赖 -->
  <build_depend>libeigen3-dev</build_depend>
  <exec_depend>libeigen3-dev</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>